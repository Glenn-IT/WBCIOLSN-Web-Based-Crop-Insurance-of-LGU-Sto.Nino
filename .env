# ============================================================
# Environment Configuration
# Web-Based Crop Insurance System
# ============================================================

APP_ENV=development
APP_NAME=LGU Crop Insurance
APP_URL=http://localhost/web-based-crop-insurance

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=crop_insurance_db
DB_USER=root
DB_PASS=

# JWT
JWT_SECRET=LGU_CropIns_ChangeMe_2026_SecretKey!@#$%^&*
JWT_EXPIRY=86400

# File Uploads
UPLOAD_MAX_SIZE=5242880
UPLOAD_PATH=uploads

# Mail (optional — set for real email; leave blank to skip)
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=no-reply@lgu-stonino.gov.ph
MAIL_FROM_NAME=LGU Crop Insurance
