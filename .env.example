# ============================================================
# Environment Variables - Web-Based Crop Insurance System
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# Application
APP_NAME="Web-Based Crop Insurance"
APP_ENV=development
APP_URL=http://localhost/web-based-crop-insurance
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=crop_insurance_db
DB_USER=root
DB_PASS=

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_key
JWT_EXPIRY=86400

# File Uploads
UPLOAD_MAX_SIZE=5242880
UPLOAD_PATH=uploads/
ALLOWED_TYPES=jpg,jpeg,png,pdf

# Email (PHPMailer)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=noreply@cropinsurance.ph
MAIL_FROM_NAME="Crop Insurance System"
