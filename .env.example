# ============================================================
# Environment Variables - Web-Based Crop Insurance System
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# Application
APP_NAME="Web-Based Crop Insurance"
APP_ENV=development
APP_URL=http://localhost/web-based-crop-insurance
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=crop_insurance_db
DB_USER=root
DB_PASS=

# JWT
JWT_SECRET=change_this_secret_key_to_a_secure_random_string_here
JWT_EXPIRY=86400

# File Uploads
UPLOAD_MAX_SIZE=10485760
UPLOAD_PATH=uploads/
ALLOWED_TYPES=jpg,jpeg,png,pdf

# Email (PHPMailer + Gmail SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME="Crop Insurance System"

# SMS Gateway (PhilSMS)
SMS_ENABLED=true
PHILSMS_API_KEY=
PHILSMS_API_URL=https://dashboard.philsms.com/api/v3/sms/send
PHILSMS_SENDER_ID=PhilSMS
